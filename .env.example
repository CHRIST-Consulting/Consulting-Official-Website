# MongoDB Connection URI (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cicf_database?retryWrites=true&w=majority

# JWT Secret for Admin Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# Google Apps Script Web App URL (for sending Contact & Forgot Password Emails)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# Backend Server Port (local development)
PORT=5000

# Optional: Override API Base URL for Frontend (defaults to /api on production, http://localhost:5000/api in dev)
# VITE_API_URL=http://localhost:5000/api
