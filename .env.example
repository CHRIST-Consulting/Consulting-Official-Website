# Copy this file to .env.local for local development and fill in the values.
# NEVER commit real values. In production, set these in Vercel:
#   Project → Settings → Environment Variables.

# --- Admin login -------------------------------------------------------------
# Username for the admin panel (/admin/login).
ADMIN_USERNAME=admin
# scrypt hash of the admin password. Generate it with:
#   npm run hash-password
ADMIN_PASSWORD_HASH=
# Random secret (at least 32 characters) used to sign admin session cookies.
# `npm run hash-password` also prints a fresh one you can use.
SESSION_SECRET=

# --- Contact submissions storage (MongoDB Atlas) -----------------------------
# Connection string of the CICF cluster (Atlas → Connect → Drivers), e.g.
#   mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Required in production. Leave blank locally to store submissions in
# .data/contact-submissions.json instead.
MONGODB_URI=
# Database name inside the cluster (optional, defaults to cicf_website).
# Submissions go to its `contact_submissions` collection.
MONGODB_DB=cicf_website

# --- Email notifications (NOT IMPLEMENTED YET — pending IT approval) ---------
# Placeholders for when SMTP / email API access is approved. See the TODO in
# api/contact.ts.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL_TO=consultancy@christuniversity.in
